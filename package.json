{
  "name": "porotranslator",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "prod": "docker compose up -d --build",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -p porotranslator-dev up --build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "discord.js": "14.27.0",
    "openai": "4.104.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
